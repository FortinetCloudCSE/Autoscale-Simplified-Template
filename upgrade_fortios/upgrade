#!/usr/bin/env bash
# upgrade — FortiGate autoscale upgrade entry point
#
# Usage:
#   ./upgrade --in-place  --fortios-version 7.6.8  [--state state/autoscale_template.tfstate]
#   ./upgrade --blue-green --fortios-version 7.6.8  [--state state/autoscale_template.tfstate]
#
# Runs state/refresh.sh, discover.py and inplace_upgrade.py in order.
# Expects state files in ./state/ by default.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_DIR="${SCRIPT_DIR}/state"
SCRIPTS_DIR="${SCRIPT_DIR}/scripts"

STATE_FILE="${STATE_DIR}/autoscale_template.tfstate"
INVENTORY_FILE="${STATE_DIR}/blue_inventory.json"

MODE=""
FORTIOS_VERSION=""

# ── Argument parsing ──────────────────────────

usage() {
    cat <<EOF
Usage: $(basename "$0") <mode> --fortios-version <version> [options]

Modes:
  --in-place     Replace the instances of the existing ASGs from an updated launch template
  --blue-green   Deploy parallel environment and cut over (manual runbook, not automated here)

Options:
  --fortios-version <version>   Target FortiOS version (e.g. 7.6.8)  [required]
  --state <path>                Path to the autoscale_template state file
                                (default: state/autoscale_template.tfstate)
  --inventory <path>            Path to existing blue_inventory.json
                                (skips the state refresh and discovery)
  --region <region>             AWS region (default: read from the state file)
  --restore-config <file>       Rolling replacement only: restore this config backup to the
                                new primary afterwards (cross-major-version upgrades)
  --fgt-api-key <key>           FortiGate REST API key for an automated config restore
  --fgt-mgmt-port <port>        FortiGate management HTTPS port (default: 443)
  --allow-single-instance       Allow replacing the only instance in the group (outage)
  --upgrade-path-verified       Confirm Fortinet's Upgrade Path Tool gives a single-step path
                                to the target version. Required when a config restore crosses
                                a minor or major version
  --help                        Show this help

Examples:
  ./upgrade --in-place --fortios-version 7.6.8
  ./upgrade --in-place --fortios-version 7.6.8 --state /path/to/terraform.tfstate
EOF
    exit 1
}

INVENTORY_OVERRIDE=""
DISCOVER_ARGS=()
UPGRADE_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --in-place)    MODE="in-place";    shift ;;
        --blue-green)  MODE="blue-green";  shift ;;
        --fortios-version)
            FORTIOS_VERSION="${2:-}"
            [[ -z "$FORTIOS_VERSION" ]] && { echo "Error: --fortios-version requires a value"; usage; }
            shift 2
            ;;
        --state)
            STATE_FILE="${2:-}"
            [[ -z "$STATE_FILE" ]] && { echo "Error: --state requires a value"; usage; }
            shift 2
            ;;
        --inventory)
            INVENTORY_OVERRIDE="${2:-}"
            shift 2
            ;;
        --region)
            [[ -z "${2:-}" ]] && { echo "Error: --region requires a value"; usage; }
            DISCOVER_ARGS+=(--region "$2")
            shift 2
            ;;
        --restore-config|--fgt-api-key|--fgt-mgmt-port)
            [[ -z "${2:-}" ]] && { echo "Error: $1 requires a value"; usage; }
            UPGRADE_ARGS+=("$1" "$2")
            shift 2
            ;;
        --allow-single-instance)
            UPGRADE_ARGS+=("$1")
            shift
            ;;
        --upgrade-path-verified)
            DISCOVER_ARGS+=("$1")
            UPGRADE_ARGS+=("$1")
            shift
            ;;
        --help|-h) usage ;;
        *) echo "Unknown argument: $1"; usage ;;
    esac
done

[[ -z "$MODE" ]] && { echo "Error: specify --in-place or --blue-green"; usage; }
[[ -z "$FORTIOS_VERSION" ]] && { echo "Error: --fortios-version is required"; usage; }

# ── Pre-flight checks ─────────────────────────

if ! command -v python3 &>/dev/null; then
    echo "Error: python3 not found"
    exit 1
fi

if ! python3 -c "import boto3" 2>/dev/null; then
    echo "Error: boto3 not installed. Run: pip3 install boto3"
    exit 1
fi

# ── Strategy header ────────────────────────────

echo ""
echo "════════════════════════════════════════════════════════════"
if [[ "$MODE" == "in-place" ]]; then
    echo "  FortiGate In-Place Upgrade"
else
    echo "  FortiGate Blue-Green Upgrade"
fi
echo "  Target FortiOS: ${FORTIOS_VERSION}"
echo "════════════════════════════════════════════════════════════"

# ── In-Place ──────────────────────────────────

if [[ "$MODE" == "in-place" ]]; then

    # Phase 0: Refresh state directory
    if [[ -n "$INVENTORY_OVERRIDE" ]]; then
        INVENTORY_FILE="$INVENTORY_OVERRIDE"
        echo ""
        echo "Using existing inventory: ${INVENTORY_FILE}"
    else
        echo ""
        echo "Phase 0: Refresh State"
        echo "──────────────────────────────────────────────────────────"

        # refresh.sh replaces the state files and the inventory. It leaves config
        # backups (*.conf) and inplace_rollback.json alone.
        bash "${STATE_DIR}/refresh.sh"

        if [[ ! -f "$STATE_FILE" ]]; then
            echo ""
            echo "Error: autoscale_template state not found after refresh: ${STATE_FILE}"
            exit 1
        fi

        echo ""
        echo "Phase 0: Discovery"
        echo "──────────────────────────────────────────────────────────"
        python3 "${SCRIPTS_DIR}/discover.py" \
            --state "${STATE_FILE}" \
            --target-version "${FORTIOS_VERSION}" \
            --output "${INVENTORY_FILE}" \
            ${DISCOVER_ARGS[@]+"${DISCOVER_ARGS[@]}"}
    fi

    echo ""
    python3 "${SCRIPTS_DIR}/inplace_upgrade.py" \
        --inventory "${INVENTORY_FILE}" \
        --state-dir "${STATE_DIR}" \
        ${UPGRADE_ARGS[@]+"${UPGRADE_ARGS[@]}"}

# ── Blue-Green ────────────────────────────────

elif [[ "$MODE" == "blue-green" ]]; then
    echo ""
    echo "Blue-green upgrade is not yet implemented as an automated script."
    echo ""
    echo "Follow the manual runbook: upgrade_fortios/RUNBOOK.md"
    echo ""
    echo "The discovery step is available:"
    echo "  python3 scripts/discover.py --state ${STATE_FILE} \\"
    echo "    --target-version ${FORTIOS_VERSION} \\"
    echo "    --output state/blue_inventory.json"
    exit 1
fi
