diagnose sys forticonverter set-prompt-visibility hidden
config system probe-response
    set mode http-probe
    set port 8008
    set http-probe-value "OK"
end
config system interface
    edit port1
        set allowaccess ping http https probe-response
        set defaultgw disable
    next
    edit port2
        set allowaccess ping http https
        set defaultgw enable
    next
end
config system zone
    edit "private-zone"
        set interface ${join(" ", [for az in az_list : "\"geneve-${az}\""])}
    next
end
config router static
%{ for az in az_list ~}
%{ for cidr in spoke_cidrs ~}
    edit 0
        set dst ${split("/", cidr)[0]} ${cidrnetmask(cidr)}
        set distance 5
        set priority 100
        set device "geneve-${az}"
    next
%{ endfor ~}
%{ endfor ~}
%{ if enable_distributed_egress ~}
# Distributed egress: equal-distance (5), worse-priority (100 vs the real default route's
# implicit 0) default route via each geneve device. The real default route still wins every
# normal forwarding decision on priority -- this route exists only so FortiOS's reverse-path
# check has a legitimate candidate via the geneve devices for arbitrary inbound-from-internet
# sources hairpinned through a distributed VPC's Ingress Routing table.
%{ for az in az_list ~}
    edit 0
        set dst 0.0.0.0 0.0.0.0
        set distance 5
        set priority 100
        set device "geneve-${az}"
    next
%{ endfor ~}
%{ endif ~}
end
config router policy
%{ if enable_distributed_egress ~}
# Distributed egress: three scoped rules per AZ instead of one unconditional rule, so
# centralized egress (spoke -> internet) is never matched and falls through to the real
# default route instead of getting hairpinned back out geneve. Distributed forward/reply are
# matched by dst/src against the distributed VPC CIDRs specifically; centralized east-west is
# matched by src+dst both against the centralized spoke CIDRs (not the merged list).
%{ for az in az_list ~}
    edit 0
        set input-device "geneve-${az}"
        set dst ${join(" ", [for cidr in distributed_egress_cidrs : "\"${cidr}\""])}
        set output-device "geneve-${az}"
    next
%{ endfor ~}
%{ for az in az_list ~}
    edit 0
        set input-device "geneve-${az}"
        set src ${join(" ", [for cidr in distributed_egress_cidrs : "\"${cidr}\""])}
        set output-device "geneve-${az}"
    next
%{ endfor ~}
%{ for az in az_list ~}
    edit 0
        set input-device "geneve-${az}"
        set src ${join(" ", [for cidr in centralized_spoke_cidrs : "\"${cidr}\""])}
        set dst ${join(" ", [for cidr in centralized_spoke_cidrs : "\"${cidr}\""])}
        set output-device "geneve-${az}"
    next
%{ endfor ~}
%{ else ~}
%{ for az in az_list ~}
    edit 0
        set input-device "geneve-${az}"
        set output-device "geneve-${az}"
    next
%{ endfor ~}
%{ endif ~}
end
config firewall policy
    edit 0
        set name "private_to_internet"
        set srcintf "private-zone"
        set dstintf "port2"
        set action accept
        set srcaddr "all"
        set dstaddr "all"
        set schedule "always"
        set service "ALL"
        set nat enable
    next
    edit 0
        set name "private_to_private"
        set srcintf "private-zone"
        set dstintf "private-zone"
        set action accept
        set srcaddr "all"
        set dstaddr "all"
        set schedule "always"
        set service "ALL"
        set nat disable
    next
end
%{ if enable_distributed_egress_endpoint_id ~}
# Mode B (EXPERIMENTAL): overlapping-CIDR distributed egress via GENEVE endpoint-id. Requires an
# STS/test FortiOS build -- not available on any generally-available FortiOS release as of this
# writing. See MODE_B_ENDPOINT_ID_GENEVE.md at the repo root and
# content/5_Templates/5_7_Overlapping_CIDR_Egress for the full design writeup and CLI reference
# this block is templatized from. Centralized (private-zone / geneve-${az_list[0]}, etc. above) is
# entirely untouched by this block -- those tunnels are created post-boot by the vendored autoscale
# Lambda, not this bootstrap config, and Mode B never needed to retag them (the two spoke CIDRs
# were never ambiguous to begin with). Every device below is new and self-contained.
config system geneve
%{ for d in distributed_egress_endpoint_id_devices ~}
%{ for az in distributed_az_list ~}
    edit "${d.key}-geneve-${az}"
        set interface "port1"
        set type ppp
        set endpoint-id "${d.vpce_by_az[az]}"
        set remote-ip ${shared_gwlb_ip_by_az[az]}
    next
%{ endfor ~}
%{ endfor ~}
end
%{ if distributed_egress_routing_mode == "vrf" ~}
# VRF mode: each distributed VPC's tunnels get their own routing table, structurally eliminating
# cross-VPC RPF/routing ambiguity for the overlapping CIDR (see fix #2 in
# MODE_B_ENDPOINT_ID_GENEVE.md). Router-policy AZ-symmetry pinning below is still required either
# way -- VRF doesn't remove that, it's a separate concern from cross-VPC ambiguity.
config system interface
%{ for d in distributed_egress_endpoint_id_devices ~}
%{ for az in distributed_az_list ~}
    edit "${d.key}-geneve-${az}"
        set vdom "root"
        set vrf ${d.vrf}
        set type geneve
        set interface "port1"
    next
%{ endfor ~}
%{ endfor ~}
end
%{ endif ~}
config system zone
%{ for d in distributed_egress_endpoint_id_devices ~}
    edit "${d.zone}"
        set interface ${join(" ", [for az in distributed_az_list : "\"${d.key}-geneve-${az}\""])}
    next
%{ endfor ~}
end
# No zone-to-zone or zone-to-internet policy exists between distributed VPCs, or from a distributed
# VPC out to port1/port2/port3 -- isolation here is structural (no permitting policy exists at all),
# not dependent on CIDR-address correctness the way Mode A's shared private-zone is.
config firewall policy
%{ for d in distributed_egress_endpoint_id_devices ~}
    edit 0
        set name "${d.key}_hairpin"
        set srcintf "${d.zone}"
        set dstintf "${d.zone}"
        set action accept
        set srcaddr "all"
        set dstaddr "all"
        set schedule "always"
        set service "ALL"
        set nat disable
    next
%{ endfor ~}
end
config router static
%{ for d in distributed_egress_endpoint_id_devices ~}
%{ for az in distributed_az_list ~}
    edit 0
%{ if distributed_egress_routing_mode == "vrf" ~}
        set vrf ${d.vrf}
%{ endif ~}
        set distance 5
        set priority 100
        set device "${d.key}-geneve-${az}"
    next
    edit 0
%{ if distributed_egress_routing_mode == "vrf" ~}
        set vrf ${d.vrf}
%{ endif ~}
        set dst ${split("/", d.cidr)[0]} ${cidrnetmask(d.cidr)}
        set distance 10
        set device "${d.key}-geneve-${az}"
    next
%{ endfor ~}
%{ endfor ~}
end
config router policy
%{ for d in distributed_egress_endpoint_id_devices ~}
%{ for az in distributed_az_list ~}
    edit 0
        set input-device "${d.key}-geneve-${az}"
        set dst "${split("/", d.cidr)[0]}/${cidrnetmask(d.cidr)}"
        set output-device "${d.key}-geneve-${az}"
    next
    edit 0
        set input-device "${d.key}-geneve-${az}"
        set src "${split("/", d.cidr)[0]}/${cidrnetmask(d.cidr)}"
        set output-device "${d.key}-geneve-${az}"
    next
%{ endfor ~}
%{ endfor ~}
end
%{ endif ~}
config system fortiguard
    set auto-firmware-upgrade disable
    set interface-select-method specify
    set interface port3
end
config system global
    set gui-auto-upgrade-setup-warning disable
    set gui-firmware-upgrade-warning disable
    set admin-lockout-duration 0
end
config system interface
    edit port3
        set vrf 1
        set allowaccess ping https http ssh snmp fgfm
        set defaultgw enable
        set dedicated-to management
    next
yend
